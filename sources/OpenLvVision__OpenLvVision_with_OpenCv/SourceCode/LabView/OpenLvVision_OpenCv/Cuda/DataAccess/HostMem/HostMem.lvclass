<LVClass LVVersion="20008000">
	<Property Name="NI.Lib.ContainingLib" Type="Str">OpenLvVision_OpenCv.lvlib:Cuda.lvlib</Property>
	<Property Name="NI.Lib.ContainingLibPath" Type="Str">../../../Cuda.lvlib</Property>
	<Property Name="NI.Lib.Description" Type="Str">Represents a specialized buffer of page-locked (or "pinned") host system memory. Unlike standard pageable RAM, the operating system guarantees that pinned memory will not be moved or swapped to disk. This stability allows the GPU to utilize Direct Memory Access (DMA) to fetch and transfer data across the PCIe bus at maximum possible bandwidth. It is used as a high-performance staging area to accelerate data transfers (uploads and downloads) between the CPU and the GPU matrix.</Property>
	<Property Name="NI.Lib.HelpPath" Type="Str"></Property>
