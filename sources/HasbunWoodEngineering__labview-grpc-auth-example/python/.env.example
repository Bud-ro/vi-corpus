# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (SQLite)
SQLITE_PATH=/app/data/db.sqlite3

# MFA
MFA_TOTP_ISSUER=Auth Toolkit
DEVICE_LINK_TTL_SECONDS=300

# JWT
JWT_SECRET_KEY=change-me-too
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-clients
JWT_ACCESS_TTL_SECONDS=900

# Encryption (TOTP secrets at rest)
# Stored in ./secrets/fernet.key inside the container.

# Public URL (used to build login URL for apps)
PUBLIC_BASE_URL=http://localhost:8000
