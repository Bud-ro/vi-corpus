            <Socket>PXIe-6592R IO Socket v1</Socket>
         </CompatibleCLIPSocketList>
         <DeclarationPaths>
            <Absolute>C:\Users\ni\Documents\Repository\_943\FPGA\6592R\CLIP\UserRTL_Quad_Aurora_x1_NI_6592R.xml</Absolute>
            <MD5>d5bfa10b7e2ab824ca1c16d8a6a01c92</MD5>
            <RelativeToLabVIEW>..\..\..\Users\ni\Documents\Repository\_943\FPGA\6592R\CLIP\UserRTL_Quad_Aurora_x1_NI_6592R.xml</RelativeToLabVIEW>
            <RelativeToNiPubDocs>..\..\..\ni\Documents\Repository\_943\FPGA\6592R\CLIP\UserRTL_Quad_Aurora_x1_NI_6592R.xml</RelativeToNiPubDocs>
            <RelativeToNiSharedDir>..\..\Users\ni\Documents\Repository\_943\FPGA\6592R\CLIP\UserRTL_Quad_Aurora_x1_NI_6592R.xml</RelativeToNiSharedDir>
