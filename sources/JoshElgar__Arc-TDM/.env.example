# Required together to enable Clerk.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required for Chat. Leave blank if you only need Assets, Workbooks, Data, and Settings.
OPENAI_API_KEY=

# Required only for workbook steps that send email through Arc email delivery.
RESEND_API_KEY=

# Optional comma-separated production origins, for example:
# ARC_ALLOWED_ORIGINS=https://your-frontend.example.com
ARC_ALLOWED_ORIGINS=
